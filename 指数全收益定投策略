    <script>
        let indexNames = [];
        let currentIndex = "";
        const mainChart = echarts.init(document.getElementById('chart-main'), 'dark');
        const ddChart = echarts.init(document.getElementById('chart-dd'), 'dark');

        window.onload = function() {
            const saved = localStorage.getItem('drawdown_tool_data_v9');
            if (saved) {
                try { allData = JSON.parse(saved); } catch(e) { console.error(e); }
            }
            
            indexNames = Object.keys(allData);
            if (indexNames.length === 0) return;
            currentIndex = indexNames[0];

            const selector = document.getElementById('index-selector');
            selector.innerHTML = '';
            indexNames.forEach(name => {
                const btn = document.createElement('button');
                btn.className = 'btn' + (name === currentIndex ? ' active' : '');
                btn.innerText = name;
                btn.onclick = () => {
                    currentIndex = name;
                    document.querySelectorAll('#index-selector .btn').forEach(b => {
                        if(indexNames.includes(b.innerText)) b.classList.remove('active');
                    });
                    btn.classList.add('active');
                    updateUI();
                };
                selector.appendChild(btn);
            });
            
            document.getElementById('new-date').value = new Date().toISOString().split('T')[0];
            updateUI();
        };

        function updateUI() {
            const data = allData[currentIndex];
            document.getElementById('stat-val').innerText = data.values[data.values.length - 1].toLocaleString(undefined, {minimumFractionDigits: 2});
            document.getElementById('stat-curr-dd').innerText = data.drawdowns[data.drawdowns.length - 1].toFixed(2) + '%';
            document.getElementById('stat-max-dd').innerText = data.max_drawdown.toFixed(2) + '%';
            document.getElementById('stat-date').innerText = data.dates[data.dates.length - 1];

            document.getElementById('main-chart-title').innerText = currentIndex + ' 累计净值走势';
            document.getElementById('dd-chart-title').innerText = currentIndex + ' 历史回撤与风险分位线';

            const chartOptBase = {
                backgroundColor: 'transparent',
                textStyle: { color: '#8b949e', fontFamily: 'inherit' },
                legend: { textStyle: { color: '#c9d1d9' }, inactiveColor: '#484f58' }
            };

            mainChart.setOption({
                ...chartOptBase,
                title: { show: false },
                tooltip: { trigger: 'axis', backgroundColor: '#161b22', borderColor: '#30363d', textStyle: { color: '#e6edf3' } },
                grid: { top: 40, left: '5%', right: '5%', bottom: '15%' },
                xAxis: { type: 'category', data: data.dates, axisLine: { lineStyle: { color: '#30363d' } }, splitLine: { show: false } },
                yAxis: { type: 'value', scale: true, splitLine: { lineStyle: { color: '#21262d', type: 'dashed' } } },
                dataZoom: [{ type: 'inside' }, { type: 'slider', bottom: 10, borderColor: '#30363d', handleStyle: { color: '#1f6feb' } }],
                series: [{ 
                    name: '点位', type: 'line', data: data.values, showSymbol: false, 
                    lineStyle: { width: 2, color: '#58a6ff' },
                    areaStyle: { color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [{offset: 0, color: 'rgba(88,166,255,0.15)'}, {offset: 1, color: 'rgba(88,166,255,0)'}]) }
                }]
            }, true);

            const ddSeries = [{ 
                name: '实时回撤', type: 'line', data: data.drawdowns, showSymbol: false, 
                areaStyle: { color: 'rgba(248, 81, 73, 0.1)' }, 
                itemStyle: { color: '#f85149' }, lineStyle: { width: 2.5 }, z: 10 
            }];
            
            const pColors = { '滚动五年50%分位': '#3fb950', '滚动五年70%分位': '#d29922', '滚动五年90%分位': '#f85149', '滚动十年50%分位': '#58a6ff', '滚动十年70%分位': '#bc8cff' };
            for (const [pName, pValues] of Object.entries(data.percentiles || {})) {
                ddSeries.push({ 
                    name: pName, type: 'line', data: pValues, showSymbol: false, 
                    lineStyle: { width: 1.5, type: 'dashed', color: pColors[pName] || '#8b949e', opacity: 0.8 }, z: 5 
                });
            }

            ddChart.setOption({
                ...chartOptBase,
                title: { show: false },
                tooltip: { 
                    trigger: 'axis', backgroundColor: '#161b22', borderColor: '#30363d', textStyle: { color: '#e6edf3' },
                    formatter: (params) => {
                        let res = '<div style="font-weight:600;margin-bottom:8px;">' + params[0].axisValue + '</div>';
                        params.forEach(p => res += '<div style="display:flex;justify-content:space-between;gap:24px;"><span>' + p.marker + p.seriesName + '</span><span style="font-weight:bold;">' + (p.value !== null ? p.value + '%' : '-') + '</span></div>');
                        return res;
                    }
                },
                legend: { top: 10, data: ddSeries.map(s => s.name), itemGap: 15 },
                grid: { top: 60, left: '5%', right: '5%', bottom: '15%' },
                xAxis: { type: 'category', data: data.dates, axisLine: { lineStyle: { color: '#30363d' } } },
                yAxis: { type: 'value', name: '回撤 (%)', max: 0, splitLine: { lineStyle: { color: '#21262d', type: 'dashed' } }, axisLabel: { formatter: '{value}%' } },
                dataZoom: [{ type: 'inside' }, { type: 'slider', bottom: 10, borderColor: '#30363d' }],
                series: ddSeries
            }, true);
        }

        function setMainZoomByMonths(months) {
            const btnContainer = event.target.parentElement;
            btnContainer.querySelectorAll('.btn').forEach(b => b.classList.remove('active'));
            event.target.classList.add('active');

            const dates = allData[currentIndex].dates;
            const totalDays = dates.length;
            if (totalDays === 0) return;

            if (months === 0) {
                mainChart.dispatchAction({ type: 'dataZoom', start: 0, end: 100 });
                return;
            }

            const lastDateStr = dates[totalDays - 1];
            const lastDate = new Date(lastDateStr);
            const targetDate = new Date(lastDate.setMonth(lastDate.getMonth() - months));
            
            let startIndex = 0;
            for (let i = 0; i < totalDays; i++) {
                if (new Date(dates[i]) >= targetDate) { startIndex = i; break; }
            }
            const startPercent = (startIndex / totalDays) * 100;
            mainChart.dispatchAction({ type: 'dataZoom', start: startPercent, end: 100 });
        }

        function setDDZoomByMonths(months) {
            const btnContainer = event.target.parentElement;
            btnContainer.querySelectorAll('.btn').forEach(b => b.classList.remove('active'));
            event.target.classList.add('active');

            const dates = allData[currentIndex].dates;
            const totalDays = dates.length;
            if (totalDays === 0) return;

            if (months === 0) {
                ddChart.dispatchAction({ type: 'dataZoom', start: 0, end: 100 });
                return;
            }

            const lastDateStr = dates[totalDays - 1];
            const lastDate = new Date(lastDateStr);
            const targetDate = new Date(lastDate.setMonth(lastDate.getMonth() - months));
            
            let startIndex = 0;
            for (let i = 0; i < totalDays; i++) {
                if (new Date(dates[i]) >= targetDate) { startIndex = i; break; }
            }
            const startPercent = (startIndex / totalDays) * 100;
            ddChart.dispatchAction({ type: 'dataZoom', start: startPercent, end: 100 });
        }

        function manualUpdate() {
            const date = document.getElementById('new-date').value;
            const val = parseFloat(document.getElementById('new-value').value);
            if (!date || isNaN(val)) return alert("请输入有效的日期和数值！");
            const data = allData[currentIndex];
            const existingIdx = data.dates.indexOf(date);
            if (existingIdx !== -1) { data.values[existingIdx] = val; } 
            else { 
                data.dates.push(date); data.values.push(val); 
                for (const pName in data.percentiles) {
                    const arr = data.percentiles[pName];
                    arr.push(arr.length > 0 ? arr[arr.length-1] : null);
                }
                const combined = data.dates.map((d, i) => ({ d, v: data.values[i], p: Object.fromEntries(Object.entries(data.percentiles).map(([k, v]) => [k, v[i]])) }));
                combined.sort((a, b) => a.d.localeCompare(b.d));
                data.dates = combined.map(x => x.d); data.values = combined.map(x => x.v);
                for (const pName in data.percentiles) data.percentiles[pName] = combined.map(x => x.p[pName]);
            }
            let maxVal = 0; const newDrawdowns = []; let minDD = 0;
            for (let i = 0; i < data.values.length; i++) { if (data.values[i] > maxVal) maxVal = data.values[i]; const dd = (data.values[i] / maxVal - 1) * 100; newDrawdowns.push(parseFloat(dd.toFixed(2))); if (dd < minDD) minDD = dd; }
            data.drawdowns = newDrawdowns; data.max_drawdown = minDD;
            localStorage.setItem('drawdown_tool_data_v9', JSON.stringify(allData));
            updateUI();
            const tip = document.getElementById('save-status');
            tip.style.display = 'block';
            setTimeout(() => tip.style.display = 'none', 3000);
        }

        function downloadNewVersion() {
            try {
                const dataStr = JSON.stringify(allData);
                let htmlContent = document.documentElement.outerHTML;
                htmlContent = htmlContent.replace(/let allData =[\s\S]*?;/, `let allData = ${dataStr};`);
                const blob = new Blob([htmlContent], { type: 'text/html;charset=utf-8' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `Drawdown_Tool_Export_${new Date().toISOString().split('T')[0]}.html`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            } catch(e) {
                alert("导出失败：" + e.message);
            }
        }

        function resetToOriginal() {
            if(confirm("重置将清除所有手动更新的数据，恢复至初始状态。确定吗？")) {
                localStorage.removeItem('drawdown_tool_data_v9');
                location.reload();
            }
        }

        window.addEventListener('resize', () => { mainChart.resize(); ddChart.resize(); });
    </script>
